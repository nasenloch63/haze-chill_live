{
  "name": "haze-and-chill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:reservations": "node --conditions=react-server --import tsx --test tests/reservations.test.mjs",
    "test:seo": "node --import tsx --test tests/seo.test.mjs",
    "test": "npm run test:reservations && npm run test:seo",
    "check:seo": "node scripts/check-seo.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "indexnow:dry": "node scripts/submit-indexnow.mjs --dry-run",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "qa": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:seo"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.72",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.0",
    "lucide-react": "^0.436.0",
    "next": "16.4.3",
    "nodemailer": "^10.0.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.58.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss-selector-parser": "7.1.6"
  }
}
